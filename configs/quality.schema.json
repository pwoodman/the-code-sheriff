{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-gates.dev/schema/quality-v1.json",
  "title": "quality.toml",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_version": {"type": "integer", "const": 1},
        "languages": {"type": "array", "items": {"type": "string"}},
        "fail_on": {"type": "array", "items": {"type": "string"}},
        "ai_review": {"type": "string", "enum": ["pr-only", "always", "never"]},
        "auto_install": {"type": "boolean"},
        "trust": {"type": "string", "enum": ["trusted", "prompt", "untrusted"]},
        "offline": {"type": "boolean"},
        "execution_environment": {"type": "string", "enum": ["local", "isolated"]},
        "jobs": {"type": "integer", "minimum": 1},
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        },
        "required_tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "policy": {"type": "string", "enum": ["observe", "adopt", "enforce"]},
        "baseline": {"type": "string"},
        "comment_on_pr": {"type": "boolean"},
        "ci": {"type": "object"},
        "compile": {"type": "object"},
        "coverage": {"type": "object"},
        "audit": {"type": "object"},
        "ui": {"type": "object"},
        "impact": {"type": "object"},
        "version": {"type": "object"},
        "detect": {"type": "object"},
        "format": {"type": "object"},
        "lint": {"type": "object"},
        "dry": {"type": "object"},
        "sql": {"type": "object"},
        "review": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["auto", "openai", "anthropic", "ollama", "github-models", "off"]
            },
            "model": {"type": "string"},
            "max_diff_bytes": {"type": "integer", "minimum": 1000},
            "mode": {
              "type": "string",
              "enum": ["auto", "agentic", "ensemble", "single", "heuristic"]
            },
            "passes": {"type": "integer", "minimum": 2, "maximum": 8},
            "tool_rounds": {"type": "integer", "minimum": 0, "maximum": 8},
            "rules_dir": {"type": "string"},
            "related_files": {"type": "integer", "minimum": 0},
            "related_bytes": {"type": "integer", "minimum": 4000},
            "validate": {"type": "boolean"},
            "inline_comments": {"type": "boolean"},
            "check_run": {"type": "boolean"},
            "verify_tests": {"type": "boolean"},
            "symbol_neighbors": {"type": "boolean"},
            "incremental": {"type": "boolean"},
            "ingest_agent_files": {"type": "boolean"},
            "risk": {
              "type": "string",
              "enum": ["auto", "skip", "cheap", "full", "heuristic"]
            },
            "cheap_model": {"type": "string"},
            "full_model": {"type": "string"},
            "skip_globs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "merge": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "verify": {
              "type": "string",
              "enum": ["auto", "always", "never"]
            },
            "verify_tests": {"type": "boolean"},
            "siblings": {"type": "boolean"},
            "base": {"type": "string"}
          }
        },
        "comments": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "in_oracle": {"type": "boolean"},
            "fail": {"type": "boolean"}
          }
        },
        "regex": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "include_defaults": {"type": "boolean"},
            "rules": {"type": "array", "items": {"type": "object"}}
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": "boolean"},
            "include_defaults": {"type": "boolean"},
            "require_declared": {"type": "boolean"},
            "allow": {"type": "array", "items": {"type": "string"}},
            "deny": {"type": "array", "items": {"type": "object"}}
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "require_for_source": {"type": "boolean"},
            "timing": {"type": "boolean"},
            "timing_regression_pct": {"type": "number"},
            "timing_min_delta_ms": {"type": "number"}
          }
        },
        "migration": {"type": "object"},
        "authorization": {"type": "object"},
        "resilience": {"type": "object"},
        "mutation": {"type": "object"},
        "performance": {"type": "object"},
        "plugins": {"type": "object"},
        "exceptions": {"type": "array", "items": {"type": "object"}},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
