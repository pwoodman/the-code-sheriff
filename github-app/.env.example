# The Code Sheriff GitHub App secrets. Copy to .quality-app/credentials.env after register.

QUALITY_APP_ID=
QUALITY_APP_WEBHOOK_SECRET=
QUALITY_APP_PRIVATE_KEY=.quality-app/app.pem

# Optional. Default path does not dispatch to this repo.
QUALITY_APP_DISPATCH_TOKEN=

QUALITY_APP_HOME_REPO=pwoodman/the-code-sheriff
QUALITY_APP_DISPATCH_REF=main
